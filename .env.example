# ========================================================
# MyCloud Stack (Seafile + Immich) Configuration
# ========================================================

# --- 1. Host Binding & Ports ---
# Use 127.0.0.1 if using a local reverse proxy (Caddy / Traefik / Nginx),
# or 0.0.0.0 / your host's Tailscale/LAN IP for direct exposure.
MYCLOUD_IP=127.0.0.1
SEAFILE_PORT=9085
IMMICH_PORT=2283

# Docker Network Name
SHARED_NETWORK=shared_net

# Timezone (e.g. UTC, Europe/Paris, Africa/Tunis, America/New_York)
TZ=UTC

# --- 2. Base Storage Directory ---
# Base directory on the host where all data, databases, and uploads are stored.
DATA_DIR=/srv/data/mycloud

# Optional Granular Storage Paths (defaults to subfolders of DATA_DIR if omitted):
# SEAFILE_DATA_DIR=/srv/data/mycloud/seafile/data
# SEAFILE_DB_DIR=/srv/data/mycloud/seafile/mariadb
# IMMICH_UPLOAD_DIR=/srv/data/mycloud/immich/upload
# IMMICH_CACHE_DIR=/srv/data/mycloud/immich/models
# IMMICH_DB_DIR=/srv/data/mycloud/immich/postgres

# --- 3. Seafile Configuration ---
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=change_this_to_a_secure_admin_password
SEAFILE_SERVER_HOSTNAME=mycloud.example.com
SEAFILE_SERVER_LETSENCRYPT=false

# Seafile MariaDB root password (generate via: openssl rand -hex 16)
DB_MYSQL_ROOT_PASSWORD=generate_a_secure_random_mariadb_password

# --- 4. Immich Configuration ---
# Immich version (e.g. "release" or pinned "v1.118.0")
IMMICH_VERSION=release

# Immich PostgreSQL credentials (generate via: openssl rand -hex 16)
DB_PASSWORD=generate_a_secure_random_postgres_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_HOSTNAME=immich_postgres
REDIS_HOSTNAME=immich_redis
